---
interface Props {
    text: string;
    as?: keyof astroHTML.JSX.IntrinsicElements;
    class?: string;
    style?: string;
    ariaLabel?: string;
}
const { text, as = 'span', class: className = '', style, ariaLabel } = Astro.props as Props;
const Tag = as as any;
const parts = Array.from(text);
---

<Tag class={className} style={style} aria-label={ariaLabel ?? text}>
    {parts.map((p, i) => (
        <span class="split-char" data-index={i}>{p === ' ' ? '\u00A0' : p}</span>
    ))}
</Tag>