<div>
    <header class="header">
        <a class="range" href="/" aria-label="home">
            <canvas id="header-logo" width="400" height="400"></canvas>
        </a>
        <ul>
            <li class="range">
                <a href="/works/" aria-label="works">Works</a>
            </li>
            <li class="range">
                <a href="/about/" aria-label="about">About</a>
            </li>
        </ul>
    </header>
</div>

<script>
const setupHeaderLogo = async () => {
    const logoCanvas = document.getElementById('header-logo') as HTMLCanvasElement;
    if (logoCanvas) {
        const rive = await import("@rive-app/canvas");
        const r = new rive.Rive({
            src: `/animation/logomotion.riv`,
            canvas: logoCanvas,
            autoplay: true,
            onLoad: () => {
                r.resizeDrawingSurfaceToCanvas();
            },
        });
    }
}

setupHeaderLogo();
</script>
