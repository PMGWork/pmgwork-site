---
import '../styles/global.scss';
import Stalker from '../components/Stalker.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <link rel="stylesheet" href="https://use.typekit.net/wvf5bje.css" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700&family=Noto+Sans+JP:wght@500;700&display=swap" rel="stylesheet" />
        <title>{Astro.props.title || 'ぴくせる'}</title>
    </head>
    <body>
        <Stalker />
        <Header />
        <div id="loading"></div>
        <slot />
        <script is:inline>
            window.onload = function() {
                document.getElementById("loading").classList.remove('load');
            };

            (() => {
                const TRANSITION_MS = 300;
                const loading = document.querySelector('#loading');
                if (!loading) return;

                const isInternal = (url) => {
                    try {
                        const u = new URL(url, window.location.href);
                        return u.origin === window.location.origin;
                    } catch (_) { return false; }
                };

                const shouldIgnore = (a) => {
                    const href = a.getAttribute('href') || '';
                    if (href.startsWith('#')) return true;
                    if (a.hasAttribute('download')) return true;
                    const target = a.getAttribute('target');
                    if (target && target !== '_self') return true;
                    if (a.dataset.noTransition !== undefined) return true;
                    if (!isInternal(href)) return true;
                    return false;
                };

                const handleClick = (e) => {
                    const a = e.currentTarget;
                    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                    if (shouldIgnore(a)) return;
                    e.preventDefault();
                    loading.classList.add('load');
                    const href = a.href || a.getAttribute('href');
                    let navigated = false;
                    const navigate = () => {
                        if (navigated) return;
                        navigated = true;
                        window.location.href = href;
                    };
                    const onEnd = (event) => {
                        if (event.target === loading && event.propertyName === 'opacity') {
                            loading.removeEventListener('transitionend', onEnd);
                            navigate();
                        }
                    };
                    loading.addEventListener('transitionend', onEnd, { once: true });
                    window.setTimeout(navigate, TRANSITION_MS + 50);
                };

                const bind = () => {
                    document.querySelectorAll('a[href]').forEach((a) => {
                        a.removeEventListener('click', handleClick);
                        a.addEventListener('click', handleClick);
                    });
                };

                bind();

                const observer = new MutationObserver(() => bind());
                observer.observe(document.body, { childList: true, subtree: true });

                window.addEventListener('pageshow', (e) => {
                    if (e.persisted) {
                        loading.classList.remove('load');
                    }
                });
            })();
        </script>
    </body>
</html>
