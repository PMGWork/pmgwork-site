---
import '../styles/global.scss';
import Stalker from '../components/Stalker.astro';
import Header from '../components/Header.astro';

const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <link rel="stylesheet" href="https://use.typekit.net/wvf5bje.css" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700&family=Noto+Sans+JP:wght@500;700&display=swap" rel="stylesheet" />
        <title>{Astro.props.title || 'ぴくせる'}</title>
    </head>
    <body class:list={{ "is-home": isHome }}>
        <Stalker />
        <Header />
        <div id="background"></div>
        <div id="swup" class="transition-fade">
            <slot />
        </div>

        <script>
            import Swup from 'swup';
            import SwupHeadPlugin from '@swup/head-plugin';
            import BodyClassPlugin from '@swup/body-class-plugin';

            const swup = new Swup({
                containers: ['#swup'],
                plugins: [
                    new BodyClassPlugin(),
                    new SwupHeadPlugin(),
                ],
                linkSelector: 'a[href^="/"]:not([data-no-swup]):not([href^="#"]):not([target]):not([download])',
                cache: false
            });
        </script>
    </body>
</html>
