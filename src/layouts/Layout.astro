---
import '../styles/global.scss';
import Stalker from '../components/Stalker.astro';
import Header from '../components/Header.astro';
---
<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="https://use.typekit.net/wvf5bje.css" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700&family=Noto+Sans+JP:wght@500;700&display=swap" rel="stylesheet" />
		<title>{Astro.props.title || 'ぴくせる'}</title>

	</head>
	<body>
		<div>
			<Stalker />
			<Header />
			<slot />
		</div>
	</body>
</html>
