---
import '../styles/global.scss';
import Stalker from '../components/Stalker.tsx';
import Header from '../components/Header.tsx';

const isTop = Astro.url.pathname === "/";
const isWork = /^\/works\/.+/.test(Astro.url.pathname);
const title = (Astro.props.title as string) || 'Pixel';
const description = (Astro.props.description as string) || 'Pixel | Motion Graphic Designer';
const robots = (Astro.props.robots as string) || 'index,follow';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="stylesheet" href="https://use.typekit.net/wvf5bje.css" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700&family=Noto+Sans+JP:wght@500;700&display=swap" rel="stylesheet" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content={robots} />
        <link rel="canonical" href={canonical.toString()} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="/logo.svg" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@pmgwork" />
        <script>
            import swup from '../lib/utils/swup';
            import { ScrollSmoother } from '../lib/utils/gsap';
            import { animateShared, animateAbout, animateWork, animateWorks } from '../lib/animations/';

            // ページ遷移時にページビューイベントを発火させる
            window.dispatchEvent(new CustomEvent('swup:page:view'));

            // Smoother の初期化
            function initSmoother() {
                return ScrollSmoother.create({
                    wrapper: '#swup',
                    content: '#smooth-content',
                    smooth: 0.6,
                    smoothTouch: 0.1,
                });
            }
            initSmoother();

            // アニメーションの初期化
            function initAnimations() {
                const currentPath = window.location.pathname;

                // 全ページ共通
                animateShared();

                // ページ固有のアニメーション
                if (currentPath === '/works' || currentPath === '/works/') animateWorks();
                if (currentPath === '/about' || currentPath === '/about/') animateAbout();
                if (currentPath.startsWith('/works/') && currentPath !== '/works/') animateWork();
            }
            initAnimations();

            // 背景用の body クラスを更新（CSS駆動に移行）
            function updateBackgroundClass(pathname: string) {
                const isWorkPath = /^\/works\/.+/.test(pathname);
                document.body.classList.toggle('is-work', isWorkPath);
            }
            // 初期適用
            updateBackgroundClass(window.location.pathname);

            // 共有: URLをクリップボードにコピー
            document.addEventListener('click', (ev) => {
                const t = ev.target as HTMLElement | null;
                const btn = t?.closest('[data-copy-url]') as HTMLElement | null;
                if (!btn) return;
                ev.preventDefault();
                const url = (btn as HTMLAnchorElement).dataset.url || window.location.href;
                const done = () => {
                    alert('コピーしました');
                };
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(done).catch(() => {
                        window.prompt('Copy URL', url);
                    });
                } else {
                    window.prompt('Copy URL', url);
                }
            });

            // 遷移開始時に次ページに合わせて更新
            swup.hooks.on('visit:start', (visit) => {
                const nextUrl = visit?.to?.url ? new URL(visit.to.url, location.origin) : null;
                const nextPath = nextUrl ? nextUrl.pathname : '';
                updateBackgroundClass(nextPath);
            });

            // 差し替え直後に初期化
            swup.hooks.on('content:replace', () => {
                initSmoother()?.scrollTo(0, false);
                initAnimations();
                updateBackgroundClass(window.location.pathname);
            });
        </script>
    </head>
    <body class:list={{ "is-top": isTop, "is-work": isWork }}>
        <Stalker client:load />
        <Header client:load />
        <div id="background"></div>
        <div id="swup" class="transition-fade">
            <div id="smooth-content">
                <slot />
            </div>
        </div>
    </body>
</html>
