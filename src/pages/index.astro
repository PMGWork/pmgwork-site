---
import Layout from '../layouts/Layout.astro';
import RivePlayer from '../components/RivePlayer.tsx';
import ParallaxLayers from '../components/ParallaxLayers.tsx';
import { Icon } from 'astro-icon/components';
---

<Layout>
    <div class="home">
        <div id="parallax-layers">
            <ParallaxLayers client:idle />
        </div>
        <RivePlayer client:idle src="/animation/logomotion.riv" id="home-logo" />
        <div class="home-title-wrapper">
            <h1 class="title">Pixel</h1>
            <h4 class="subtitle">Motion Graphics Designer</h4>
        </div>
        <div class="home-link">
            <a class="range" href="https://x.com/pmgwork" target="_blank" aria-label="x" rel="noopener noreferrer">
                <Icon name="tabler:brand-x" class="social-icon" />
            </a>
            <a class="range" href="https://instagram.com/pmgwork" target="_blank" aria-label="instagram" rel="noopener noreferrer">
                <Icon name="tabler:brand-instagram" class="social-icon" />
            </a>
            <a class="range" href="https://youtube.com/pmgwork" target="_blank" aria-label="youtube" rel="noopener noreferrer">
                <Icon name="tabler:brand-youtube" class="social-icon" />
            </a>
            <a class="range" href="mailto:mail@pmgwork.com" target="_blank" aria-label="email" rel="noopener noreferrer">
                <Icon name="tabler:mail" class="social-icon" />
            </a>
        </div>
    </div>
</Layout>
