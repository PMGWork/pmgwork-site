---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout>
    <div class="main">
        <div id="scene">
            <canvas id="layer1" class="layer" width="1200" height="1000" data-depth="0.2"></canvas>
            <canvas id="layer2" class="layer" width="1200" height="1000" data-depth="0.25"></canvas>
            <canvas id="layer3" class="layer" width="1200" height="1000" data-depth="0.3"></canvas>
            <canvas id="layer4" class="layer" width="1200" height="1000" data-depth="0.35"></canvas>
            <canvas id="layer5" class="layer" width="1200" height="1000" data-depth="0.4"></canvas>
            <canvas id="layer6" class="layer" width="1200" height="1000" data-depth="0.45"></canvas>
        </div>
        <canvas id="main-logo" width="800" height="800"></canvas>
        <div class="main-title-wrapper">
            <h1 class="main-title ts">Pixel</h1>
            <h4 class="main-subtitle ts">Motion Graphics Designer</h4>
        </div>
        <div class="main-link">
            <a class="range" href="https://twitter.com/pmgwork" target="_blank" aria-label="twitter" rel="noopener noreferrer">
                <Icon name="simple-icons:x" class="social-icon" />
            </a>
            <a class="range" href="https://instagram.com/pmgwork" target="_blank" aria-label="instagram" rel="noopener noreferrer">
                <Icon name="simple-icons:instagram" class="social-icon" />
            </a>
            <a class="range" href="https://youtube.com/pmgwork" target="_blank" aria-label="youtube" rel="noopener noreferrer">
                <Icon name="simple-icons:youtube" class="social-icon" />
            </a>
            <a class="range" href="mailto:mail@pmgwork.com" target="_blank" aria-label="email" rel="noopener noreferrer">
                <Icon name="simple-icons:gmail" class="social-icon" />
            </a>
        </div>

    </div>
</Layout>

<script>
document.addEventListener('DOMContentLoaded', async function() {
    // 動的インポートでモジュールを読み込み
    const [
        { splitTextToSpans },
        { hideHeaderLogo },
        { initializeRiveLayers, initializeMainLogo },
        { setupParallax },
        { setupViewportHeight }
    ] = await Promise.all([
        import('../lib/dom/text.js'),
        import('../lib/ui/header.js'),
        import('../lib/animations/rive.js'),
        import('../lib/animations/parallax.js'),
        import('../lib/dom/viewport.js')
    ]);

    // 初期化処理を並列実行
    await Promise.all([
        splitTextToSpans(),
        initializeRiveLayers(),
        initializeMainLogo(),
        hideHeaderLogo()
    ]);

    // ビューポート高さとパララックスを設定
    const disposeViewport = setupViewportHeight();
    const parallaxHandler = setupParallax();

    // クリーンアップ
    window.addEventListener('beforeunload', () => {
        if (parallaxHandler) {
            document.removeEventListener('mousemove', parallaxHandler);
        }
        if (disposeViewport) {
            disposeViewport();
        }
    });
});
</script>
