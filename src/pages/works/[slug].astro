---
import Layout from '../../layouts/Layout.astro';
import type { WorksResponse, Work } from '../../types/global';
import { formatDate } from '../../lib/utils/date';
import sanitize from 'sanitize-html';
import { Icon } from 'astro-icon/components';
import { gql } from 'graphql-request';
import { graphcmsClient } from '../../lib/clients/graphcms';

export async function getStaticPaths() {
    const { works } = await graphcmsClient.request<WorksResponse>(
        gql`
            {
                works(orderBy: date_DESC) {
                    slug
                    title
                    isClient
                    date
                    link
                    color {
                        hex
                    }
                    color1 {
                        hex
                    }
                    thumbnail {
                        webp: url(
                            transformation: {
                                document: { output: { format: webp } }
                            }
                        )
                        url
                        height
                        width
                    }
                    credits {
                        title
                        name
                    }
                    body {
                        html
                    }
                    images {
                        webp: url(
                            transformation: {
                                image: { resize: { width: 640, height: 360, fit: clip } }
                                document: { output: { format: webp } }
                            }
                        )
                        url
                        height
                        width
                    }
                }
            }
        `
    );

    return works.map((work, index) => {
        const next = works[index + 1];
        return {
            params: { slug: work.slug },
            props: {
                work,
                next: next
                    ? {
                          slug: next.slug,
                          title: next.title,
                          color: next.color,
                          color1: next.color1
                      }
                    : null
            }
        };
    });
}

interface Props {
    work: Work;
    next: {
        slug: string;
        title: string;
        color: { hex: string };
        color1: { hex: string };
    } | null;
}

const { work, next } = Astro.props as Props;
---

<Layout title={`${work.title} | Pixel`}>
    <div class="work">
        <div>
            <div id="work-wrapper" style={`background-image: linear-gradient(135deg, ${work.color.hex}, ${work.color1.hex});`} >
                <div class="work-image">
                    <picture>
                        {work.thumbnail.webp && (
                            <source srcset={work.thumbnail.webp} type="image/webp" />
                        )}
                        <img
                            src={work.thumbnail.url}
                            width={work.thumbnail.width}
                            height={work.thumbnail.height}
                            alt={work.title}
                            fetchpriority="high"
                            decoding="async"
                            oncontextmenu="return false;"
                            onselectstart="return false;"
                            onmousedown="return false;"
                        />
                    </picture>
                </div>
                <div class="work-title-wrapper">
                    <h2 class="title">{work.title}</h2>
                    {work.isClient ? (
                        <p class="subtitle">Client Work - {formatDate(work.date)}</p>
                    ) : (
                        <p class="subtitle">Personal Work - {formatDate(work.date)}</p>
                    )}
                </div>
                <div class="work-info">
                    <div class="info-items">
                        {work.credits?.map((item) => (
                            <div class="info-item">
                                <h5>{item.title}</h5>
                                <p>{item.name}</p>
                            </div>
                        ))}
                    </div>
                    {work.link && (
                        <a href={work.link} target="_blank" rel="noopener noreferrer" class="info-play">
                            <h5>Play</h5>
                        </a>
                    )}
                </div>
            </div>

            <div id="work-wrapper1">
                {/** About */}
                {work.body && (
                    <div class="work-about">
                        <h2 class="heading">About</h2>
                        <div class="block font" set:html={sanitize(work.body.html)}></div>
                    </div>
                )}

                {/** Images */}
                <div class="work-block">
                    {work.images?.map((img, idx) => (
                        <div class="block-image">
                            <picture>
                                {img.webp && <source srcset={img.webp} type="image/webp" />}
                                <img
                                    src={img.url}
                                    width={img.width}
                                    height={img.height}
                                    alt={`「${work.title}」の作品画像${idx + 1}`}
                                    loading="lazy"
                                    oncontextmenu="return false;"
                                    onselectstart="return false;"
                                    onmousedown="return false;"
                                />
                            </picture>
                        </div>
                    ))}
                </div>

                {/** Share */}
                <div class="work-share">
                    <h2 class="heading">Share!</h2>
                    <div class="share-link list">
                        <a class="dl" href={`https://x.com/intent/post?text=${work.title}&hashtags=pmgwork&url=https://pmgwork.com/works/${work.slug}/`} target="_blank" aria-label="x" rel="nofollow noopener noreferrer">
                            <div class="twi">
                                <Icon name="tabler:brand-x" class="social-icon" />
                                <h5>X</h5>
                            </div>
                        </a>
                        <a class="dl" href={`https://social-plugins.line.me/lineit/share?url=https://pmgwork.com/works/${work.slug}/`} target="_blank" aria-label="line" rel="nofollow noopener noreferrer">
                            <div class="line">
                                <Icon name="tabler:brand-line" class="social-icon" />
                                <h5>LINE</h5>
                            </div>
                        </a>
                        <button type="button" class="dl" aria-label="URLをコピー" data-copy-url data-url={`https://pmgwork.com/works/${work.slug}/`}>
                            <div class="copy">
                                <Icon name="tabler:copy" class="social-icon" />
                                <h5>URLをコピー</h5>
                            </div>
                        </button>
                    </div>
                </div>
            </div>

            {next && (
                <a id="next-link" class="view" href={`/works/${next.slug}/`}>
                    <div style={`background-image: linear-gradient(135deg, ${next.color.hex}, ${next.color1.hex});`} class="next">
                        <h5 class="subheading">Next Project</h5>
                        <h2 class="next-heading">{next.title}</h2>
                    </div>
                </a>
            )}
        </div>
    </div>
    <script is:inline data-swup-reload-script>
        addEventListener('click', (e) => {
            const target = e.target;
            if (!(target instanceof Element)) return;

            const trigger = target.closest('[data-copy-url]');
            if (!trigger) return;

            e.preventDefault();

            const url = trigger.dataset?.url || location.href;
            const notify = () => alert('コピーしました');
            navigator.clipboard?.writeText
                ? navigator.clipboard.writeText(url).then(notify).catch(() => prompt('Copy URL', url))
                : prompt('Copy URL', url);
        });
    </script>
</Layout>
