---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

import { gql } from 'graphql-request';
import { graphcmsClient } from '../../lib/clients/graphcms';
import type { WorksResponse } from '../../types/global';
import { formatDate } from '../../lib/utils/date';

// GraphCMSからデータを取得
const { works } = await graphcmsClient.request<WorksResponse>(
    gql`
        {
            works(orderBy: date_DESC) {
                slug
                title
                isClient
                date
                color {
                    hex
                }
                color1 {
                    hex
                }
                thumbnail {
                    webp: url(
                        transformation: {
                            document: { output: { format: webp } }
                        }
                    )
                    url
                    height
                    width
                }
            }
        }
    `
);
---

<Layout title="Works | Pixel">
    <div class="works">
        <div>
            <div id="bg-item"></div>
            <div class="title-wrapper">
                <h1 class="title">Works</h1>
                <p class="subtitle">Motion Graphics ・ Design ・ 3DCG</p>
            </div>
            <div class="works-wrapper">
                {works.map((work) => (
                    <div class="works-article" id={work.slug}>
                        <div class="works-image scroll view">
                            <a href={`/works/${work.slug}/`}>
                                <picture>
                                    {work.thumbnail.webp && (
                                        <source srcset={work.thumbnail.webp} type="image/webp" />
                                    )}
                                    <img
                                        src={work.thumbnail.url}
                                        width={work.thumbnail.width}
                                        height={work.thumbnail.height}
                                        alt={work.title}
                                        loading="lazy"
                                        oncontextmenu="return false;"
                                        onselectstart="return false;"
                                        onmousedown="return false;"
                                    />
                                </picture>
                            </a>
                        </div>
                        <div class="works-title-wrapper">
                            <h3 class="works-title" style={`background-image: linear-gradient(135deg, ${work.color.hex}, ${work.color1.hex});`}>
                                {work.title}
                            </h3>
                            {work.isClient ? (
                                <p class="works-subtitle">{`Client Work - ${formatDate(work.date)}`}</p>
                            ) : (
                                <p class="works-subtitle">{`Personal Work - ${formatDate(work.date)}`}</p>
                            )}
                        </div>
                    </div>
                ))}
            </div>
            <Footer />
        </div>
    </div>
</Layout>