---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import SplitText from '../../components/SplitText.astro';

import { gql } from 'graphql-request';
import { graphcmsClient } from '../../lib/clients/graphcms';
import type { WorksResponse } from '../../types/global';
import { formatDate } from '../../lib/utils/date';

// GraphCMSからデータを取得
const { works } = await graphcmsClient.request<WorksResponse>(
    gql`
        {
            works(orderBy: date_DESC) {
                slug
                title
                isClient
                date
                color {
                    hex
                }
                color1 {
                    hex
                }
                thumbnail {
                    webp: url(
                        transformation: {
                            document: { output: { format: webp } }
                        }
                    )
                    url
                    height
                    width
                }
            }
        }
    `
);
---

<Layout title="Works | ぴくせる">
    <div class="works">
        <div class="bg-white"></div>
        <div>
            <div id="bg-item"></div>
            <div class="title-wrapper">
                <SplitText text="Works" as="h1" class="title ts" />
                <SplitText text="Motion Graphics ・ Design ・ 3DCG" as="p" class="subtitle ts" />
            </div>
            <div class="works-wrapper">
                {works.map((work) => (
                    <div class="works-article" id={work.slug}>
                        <div class="works-image scroll view">
                            <a href={`/works/${work.slug}/`}>
                                <picture>
                                    {work.thumbnail.webp && (
                                        <source srcset={work.thumbnail.webp} type="image/webp" />
                                    )}
                                    <img
                                        src={work.thumbnail.url}
                                        width={work.thumbnail.width}
                                        height={work.thumbnail.height}
                                        alt={work.title}
                                        loading="lazy"
                                        oncontextmenu="return false;"
                                        onselectstart="return false;"
                                        onmousedown="return false;"
                                    />
                                </picture>
                            </a>
                        </div>
                        <div class="works-title-wrapper">
                            <SplitText as="h3" class="works-title ts" style={`background-image: linear-gradient(135deg, ${work.color.hex}, ${work.color1.hex});`} text={work.title} />
                            {work.isClient ? (
                                <SplitText as="p" class="works-subtitle ts" text={`Client Work - ${formatDate(work.date)}`} />
                            ) : (
                                <SplitText as="p" class="works-subtitle ts" text={`Personal Work - ${formatDate(work.date)}`} />
                            )}
                        </div>
                    </div>
                ))}
            </div>
            <Footer />
        </div>
    </div>
</Layout>

<script>
document.addEventListener('DOMContentLoaded', async function() {
    // 動的インポートでモジュールを読み込み
    const [
        { setupScrollAnimations }
    ] = await Promise.all([
        import('../../lib/animations/scroll.js')
    ]);

    // スクロールアニメーションを設定
    setupScrollAnimations('.scroll, .works-title, .works-subtitle');
});
</script>


