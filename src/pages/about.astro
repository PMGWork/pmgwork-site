---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import SplitText from '../components/SplitText.astro';
---

<Layout title="About | Pixel">
    <div class="about">
        <div>
            <div id="bg-item"></div>
            <div class="title-wrapper">
                <SplitText text="About" as="h1" class="title ts" />
                <SplitText text="自分について" as="p" class="subtitle ts" />
            </div>
            <div class="about-wrapper">
                <div class="about-logo">
                    <img src="/logo.svg" alt="logo">
                </div>
                <div class="about-title-wrapper">
                    <SplitText text="Pixel" as="h1" class="about-title ts" />
                    <SplitText text="Motion Graphics Designer" as="h4" class="about-subtitle ts" />
                </div>
                <div class="about-content">
                    <SplitText text="Hello!" as="h2" class="heading ts" />
                    <div class="block font">
                        <p>モーショングラフィックスや3DCGを用いた映像作品を制作しています。</p>
                        <p>映像制作等のご依頼は <a href="mailto:pmgwork.com@gmail.com">pmgwork.com@gmail.com</a> までお願いします。</p>
                    </div>
                </div>
                <div class="about-block">
                    <div class="about-tools">
                        <SplitText text="Tools" as="h2" class="heading ts" />
                        <ul class="list">
                            <li>AfterEffects</li>
                            <li>Blender</li>
                            <li>Illustrator</li>
                        </ul>
                    </div>
                    <div class="about-tools">
                        <SplitText text="Skills" as="h2" class="heading ts" />
                        <ul class="list">
                            <li>Motion Graphics</li>
                            <li>3DCG</li>
                            <li>Graphic Design</li>
                            <li>Web Design</li>
                            <li>HTML・CSS</li>
                            <li>Processing</li>
                        </ul>
                    </div>
                </div>
            </div>
            <Footer />
        </div>
    </div>
</Layout>