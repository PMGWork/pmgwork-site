---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About | Pixel">
    <div class="about">
        <div>
            <div id="hero-background"></div>
            <div class="title-wrapper">
                <h1 class="title">About</h1>
                <p class="subtitle">自分について</p>
            </div>
            <div class="about-wrapper">
                <div class="about-logo">
                    <img src="/logo.svg" alt="logo">
                </div>
                <div class="about-title-wrapper">
                    <h1 class="about-title">Pixel</h1>
                    <h4 class="about-subtitle">Motion Graphics Designer</h4>
                </div>
                <div class="about-content">
                    <h2 class="heading">Hello!</h2>
                    <div class="block font">
                        <p>モーショングラフィックスや3DCGを用いた映像作品を制作しています。</p>
                        <p>映像制作等のご依頼は <a href="mailto:pmgwork.com@gmail.com">pmgwork.com@gmail.com</a> までお願いします。</p>
                    </div>
                </div>
                <div class="about-block">
                    <div class="about-tools">
                        <h2 class="heading">Tools</h2>
                        <ul class="list">
                            <li>AfterEffects</li>
                            <li>Blender</li>
                            <li>Illustrator</li>
                        </ul>
                    </div>
                    <div class="about-tools">
                        <h2 class="heading">Skills</h2>
                        <ul class="list">
                            <li>Motion Graphics</li>
                            <li>3DCG</li>
                            <li>Graphic Design</li>
                            <li>Web Design</li>
                            <li>HTML・CSS</li>
                            <li>Processing</li>
                        </ul>
                    </div>
                </div>
            </div>
            <Footer />
        </div>
    </div>
</Layout>
